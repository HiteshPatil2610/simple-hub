# OWNER_KEY: Passcode that protects the Owner Control Hub (add/edit/delete
# products, image upload, resetting analytics). REQUIRED for any deployment
# that isn't purely local/private -- without it, the admin API and #admin
# page are open to anyone who finds the URL. Use a long random string, e.g.
# generate one with:
#   Node:       node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   PowerShell: -join ((48..57)+(97..102)|Get-Random -Count 48|%{[char]$_})
#   Python:     python -c "import secrets; print(secrets.token_hex(24))"
OWNER_KEY=9b062ef4cd3781a5
