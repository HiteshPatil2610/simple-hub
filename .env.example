# =============================================================================
# AUTHENTICATION (replaces old OWNER_KEY single-passcode system)
# =============================================================================

# JWT_SECRET: Long random string used to sign JSON Web Tokens. Required in
# production. Rotate this value to invalidate all active sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# JWT_EXPIRY: How long a login session token stays valid. Default: 8h.
# Use standard zeit/ms format: 1h, 8h, 24h, 7d, etc.
JWT_EXPIRY=8h

# OWNER_USER / OWNER_PASS: Used ONLY on the very first boot when no user
# accounts exist yet. The server creates an initial admin account from these
# values and then ignores them on subsequent starts. Remove or rotate after
# first login. Defaults to admin / changeme in development (prints a warning).
OWNER_USER=admin
OWNER_PASS=replace_with_a_strong_password

# OWNER_KEY (legacy): Kept for backwards-compatibility with old API clients
# that still send x-owner-key. New logins use JWT only.
# OWNER_KEY=replace_with_a_long_random_value

# =============================================================================
# SERVER
# =============================================================================

# Optional HTTP port. Defaults to 3000 when omitted.
PORT=3000

# =============================================================================
# PERSISTENT STORAGE
# =============================================================================

# Set these to mounted persistent-volume paths in production; otherwise the
# app uses ./data and ./public/uploads and data will be lost on redeploy.
#
# The app persists to a single SQLite database file (raccoon-hub.sqlite) inside
# DATA_DIR. On first boot, any existing data/products.json, data/clicks.json
# and data/conversions.json are imported into SQLite automatically.
# Requires Node.js >= 22.5 for the built-in node:sqlite module.
DATA_DIR=./data
UPLOADS_DIR=./public/uploads

# =============================================================================
# DATA RETENTION
# =============================================================================

# CLICK_RETENTION_DAYS: Purge click records older than this many days on startup
# and then once every 24 hours. Prevents unbounded database growth.
# Default: 90 days. Set to a higher value if you need longer history.
CLICK_RETENTION_DAYS=90

# =============================================================================
# CONVERSION WEBHOOKS (⑥)
# =============================================================================

# WEBHOOK_SECRET: Shared HMAC-SHA256 secret for signed inbound webhook payloads
# from affiliate networks (Impact, CJ Affiliate, ShareASale, etc.).
# Leave unset to disable the webhook endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_SECRET=replace_with_a_long_random_secret
