# =============================================================================
# AUTHENTICATION (Neon Auth — Managed Better Auth)
# =============================================================================
# Admin sign-in (email/password + Google) is handled entirely by Neon Auth,
# hosted alongside your database. This server only needs to VERIFY the
# tokens Neon Auth issues and decide who counts as an admin.

# NEON_AUTH_JWKS_URL: Public key endpoint used to verify tokens. Get this
# from the Neon console (Project → Auth tab) or via the Neon MCP connector's
# auth config. Looks like:
# https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
NEON_AUTH_JWKS_URL=replace_with_your_neon_auth_jwks_url

# ADMIN_EMAILS: Comma-separated allow-list. Only these emails can access the
# Owner Hub, even though Neon Auth itself allows anyone to sign up. Case-insensitive.
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# =============================================================================
# SERVER
# =============================================================================

# Optional HTTP port. Defaults to 3000 when omitted.
PORT=3000

# =============================================================================
# DATABASE (Postgres — e.g. a free Neon database)
# =============================================================================

# DATABASE_URL: Postgres connection string. Get this from your Neon project
# dashboard (or any other Postgres provider). Must include sslmode=require.
# Example: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=replace_with_your_neon_connection_string

# =============================================================================
# FRONTEND BUILD-TIME VARS (must also be set before `vite build` runs — on
# Render this means setting them as regular Environment Variables, since
# Render's build step inherits them automatically)
# =============================================================================

# VITE_NEON_AUTH_BASE_URL: Base URL of the Neon Auth service, used by the
# browser to sign in directly. Get this from the Neon console (Auth tab).
# Looks like: https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
VITE_NEON_AUTH_BASE_URL=replace_with_your_neon_auth_base_url

# =============================================================================
# UPLOADED IMAGES
# =============================================================================

# Product images are still saved to local disk at UPLOADS_DIR. This directory
# is NOT covered by the Postgres migration above — on Render's free web
# service tier the local filesystem is ephemeral, so uploaded images will
# still be lost on redeploy/restart unless you also attach a paid Render
# Persistent Disk, or switch image storage to an external host (e.g. a free
# tier of Cloudinary, ImageKit, or S3-compatible storage).
UPLOADS_DIR=./public/uploads

# =============================================================================
# DATA RETENTION
# =============================================================================

# CLICK_RETENTION_DAYS: Purge click records older than this many days on startup
# and then once every 24 hours. Prevents unbounded database growth.
# Default: 90 days. Set to a higher value if you need longer history.
CLICK_RETENTION_DAYS=90

# =============================================================================
# CONVERSION WEBHOOKS (⑥)
# =============================================================================

# WEBHOOK_SECRET: Shared HMAC-SHA256 secret for signed inbound webhook payloads
# from affiliate networks (Impact, CJ Affiliate, ShareASale, etc.).
# Leave unset to disable the webhook endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_SECRET=replace_with_a_long_random_secret
