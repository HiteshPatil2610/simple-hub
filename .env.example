# OWNER_KEY: Passcode that protects the Owner Control Hub (add/edit/delete
# products, image upload, resetting analytics). Required for every deployment.
# Use a long random string, e.g.
# generate one with:
#   Node:       node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   PowerShell: -join ((48..57)+(97..102)|Get-Random -Count 48|%{[char]$_})
#   Python:     python -c "import secrets; print(secrets.token_hex(24))"
OWNER_KEY=replace_with_a_long_random_value

# Optional HTTP port. Defaults to 3000 when omitted.
PORT=3000

# Optional persistent storage locations. Set these to mounted persistent-volume
# paths in production; otherwise the app uses ./data and ./public/uploads.
#
# Since v0.x the app persists to a single SQLite database file
# (raccoon-hub.sqlite) inside DATA_DIR instead of three JSON files. On first
# boot, any existing data/products.json, data/clicks.json and
# data/conversions.json in DATA_DIR are imported into SQLite automatically and
# then the JSON files are left untouched as a backup. Requires Node.js >= 22.5
# (Node's built-in node:sqlite module).
DATA_DIR=./data
UPLOADS_DIR=./public/uploads
