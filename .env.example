# =============================================================================
# AUTHENTICATION (custom email/password system — no external auth service)
# =============================================================================

# JWT_SECRET: Long random string used to sign JSON Web Tokens. Required in
# production. Rotate this value to invalidate all active sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# JWT_EXPIRY: How long a login session token stays valid. Default: 8h.
# Use standard zeit/ms format: 1h, 8h, 24h, 7d, etc.
JWT_EXPIRY=8h

# ADMIN_ACCOUNTS: Defines who can log in — a comma-separated list of
# email:password pairs. On every boot, each account is created if it doesn't
# exist yet, or has its password updated to match if it does (only the
# salted hash is ever stored — this env var is the source of truth for
# plaintext, briefly, at boot only). To rotate a password, just edit this
# and redeploy. To remove someone's access, delete their row from the users
# table directly (removing them here does NOT auto-delete their account).
ADMIN_ACCOUNTS=alice@example.com:her-password,bob@example.com:his-password

# OWNER_KEY (legacy): Kept for backwards-compatibility with old API clients
# that still send x-owner-key. New logins use JWT only.
# OWNER_KEY=replace_with_a_long_random_value

# =============================================================================
# SERVER
# =============================================================================

# Optional HTTP port. Defaults to 3000 when omitted.
PORT=3000

# =============================================================================
# DATABASE (Postgres — e.g. a free Neon database)
# =============================================================================

# DATABASE_URL: Postgres connection string. Get this from your Neon project
# dashboard (or any other Postgres provider). Must include sslmode=require.
# Example: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=replace_with_your_neon_connection_string

# =============================================================================
# UPLOADED IMAGES
# =============================================================================

# Product images are still saved to local disk at UPLOADS_DIR. This directory
# is NOT covered by the Postgres migration above — on Render's free web
# service tier the local filesystem is ephemeral, so uploaded images will
# still be lost on redeploy/restart unless you also attach a paid Render
# Persistent Disk, or switch image storage to an external host (e.g. a free
# tier of Cloudinary, ImageKit, or S3-compatible storage).
UPLOADS_DIR=./public/uploads

# =============================================================================
# DATA RETENTION
# =============================================================================

# CLICK_RETENTION_DAYS: Purge click records older than this many days on startup
# and then once every 24 hours. Prevents unbounded database growth.
# Default: 90 days. Set to a higher value if you need longer history.
CLICK_RETENTION_DAYS=90

# =============================================================================
# CONVERSION WEBHOOKS (⑥)
# =============================================================================

# WEBHOOK_SECRET: Shared HMAC-SHA256 secret for signed inbound webhook payloads
# from affiliate networks (Impact, CJ Affiliate, ShareASale, etc.).
# Leave unset to disable the webhook endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_SECRET=replace_with_a_long_random_secret
